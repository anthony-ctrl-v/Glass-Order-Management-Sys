{
  "name": "glass-order-management-system",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev --workspace @goms/api\" \"npm:dev --workspace @goms/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspace @goms/api",
    "db:generate": "npm run db:generate --workspace @goms/api",
    "db:migrate": "npm run db:migrate --workspace @goms/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
